# Factory/healing runtime variables. Copy to .env.local for local rehearsal,
# or configure these in the environment that runs npm run mend:heal.

MEND_MERIDIAN_URL=
MEND_MERIDIAN_VERSION=v4
# Set a random value to protect POST /mend/repair. The control room prompts for it.
MEND_FACTORY_TOKEN=
# Set this to the deployed control-room URL. Use * for a quick demo.
MEND_CONTROL_ORIGIN=*

# SigNoz Cloud: https://ingest.<region>.signoz.cloud:443
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=mend
OTEL_ENVIRONMENT=local

# Port catalogue sync. Required only for `npm run port:sync -- --live`.
PORT_API_URL=https://api.port.io
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_GITHUB_ORG=
PORT_GITHUB_REPO=

# Required by scripts/mend-activate.mjs for the live break stimulus.
CONTROL_TOKEN=

# Required by the Vercel Edge Config writer when running the control API.
MEND_VERCEL_API_TOKEN=
MEND_VERCEL_TEAM_ID=
