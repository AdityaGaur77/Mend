{
  "identifier": "zd_submit_change",
  "title": "Submit brief or change",
  "icon": "GitHub",
  "description": "Plan, build, and test a product-neutral change, then stop at the release gate.",
  "trigger": {
    "type": "self-service",
    "operation": "CREATE",
    "userInputs": {
      "properties": {
        "title": { "title": "Title", "type": "string" },
        "summary": { "title": "Summary", "type": "string" },
        "goals": { "title": "Goals", "type": "array", "items": { "type": "string" } },
        "constraints": { "title": "Constraints", "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "title": "Acceptance criteria", "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "summary", "goals", "acceptance_criteria"],
      "order": ["title", "summary", "goals", "constraints", "acceptance_criteria"]
    }
  },
  "invocationMethod": {
    "type": "INTEGRATION_ACTION",
    "installationId": "github-ocean",
    "integrationActionType": "dispatch_workflow",
    "integrationActionExecutionProperties": {
      "org": "REPLACE_WITH_GITHUB_ORG",
      "repo": "REPLACE_WITH_GITHUB_REPO",
      "workflow": "port-delivery.yml",
      "workflowInputs": {
        "operation": "prepare",
        "port_run_id": "{{ .run.id }}",
        "workflow_run_id": "{{ .run.id }}",
        "brief_json": "{{ .inputs | tojson }}",
        "plan_hash": "",
        "state_json": ""
      },
      "reportWorkflowStatus": true
    }
  },
  "requiredApproval": false,
  "allowAnyoneToViewRuns": true
}
