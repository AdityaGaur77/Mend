  "mirrorProperties": {},
  "calculationProperties": {},
  "aggregationProperties": {},
  "relations": {
    "project": { "title": "Project", "target": "zdProject", "required": true, "many": false },
    "brief": { "title": "Scientific brief", "target": "mendScientificBrief", "required": true, "many": false }
  }
}
