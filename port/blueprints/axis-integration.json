      "source_kind": { "title": "Source kind", "type": "string", "enum": ["web", "api", "dataset"] },
      "provider": { "title": "Acquisition provider", "type": "string" },
      "artifact_path": { "title": "Versioned adapter", "type": "string" },
      "factory_version": { "title": "Factory version", "type": "string" },
      "status": { "title": "Status", "type": "string", "enum": ["planned", "building", "healthy", "failed", "repair_required", "repairing"] },
      "last_record_count": { "title": "Last record count", "type": "number" },
      "last_run_id": { "title": "Last run ID", "type": "string" },
      "evidence_required": { "title": "Evidence required", "type": "boolean" }
    },
    "required": ["axis", "question", "source_name", "source_kind", "provider", "artifact_path", "factory_version", "status", "evidence_required"]
