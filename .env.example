# Everything in this repo runs with none of these set. The defaults read the
# committed mend/versions/ tree and export telemetry to a local SigNoz if one
# happens to be listening. Set these only to go live.

# Meridian — the controlled break surface (mend/). MEND_MERIDIAN_URL is the
# deployed origin; leave it unset to read the committed mend/versions/ tree,
# which is the same bytes the deployment is built from.
MEND_MERIDIAN_URL=
# The version read when no origin is set. v4 is the healthy baseline, not v1.
MEND_MERIDIAN_VERSION=v4

# OpenTelemetry. Local SigNoz defaults; for SigNoz Cloud replace the endpoint
# and put the ingestion key in ignored .env.local as: signoz-ingestion-key=<value>
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=mend
OTEL_ENVIRONMENT=local

# The control room switch that flips which version /pipeline serves without a
# redeploy. EDGE_CONFIG is injected by Vercel when an Edge Config store is
# connected to the project. With none of these set the middleware is a no-op and
# the site serves whatever was last activated — the demo does not depend on it.
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
CONTROL_TOKEN=
