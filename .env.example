# Vercel/site variables only. The factory and SigNoz variables live in
# factory.env.example so Vercel does not prompt for secrets used by the local
# or separately hosted healing process.
#
# EDGE_CONFIG is injected by Vercel when an Edge Config store is connected.
# With none of these set the middleware is a no-op and the site still serves
# the committed static site.
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
CONTROL_TOKEN=
